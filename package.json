{
  "name": "impulso-local",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs start",
    "build": "npm run check -w api && npm run build -w web",
    "check": "npm run check --workspaces",
    "test": "npm test -w api",
    "test:integration": "npm run test:integration -w api",
    "db:generate": "npm run db:generate -w api",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api"
  }
}
