{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.unit.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx src/seed.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@prisma/client": "6.19.3",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "tsx": "4.23.15",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
